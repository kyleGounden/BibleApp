# Copy to .env beside web.config on the IIS server. The app reads this file and does not commit it.
# Local dev: npm run dev
# IIS publish: npm run publish:iis, then follow the site steps. IIS sets PORT, HOST, and TRUST_PROXY.
# Authorized JavaScript origins for the Google client:
#   http://127.0.0.1:5173
#   https://your.domain

PORT=8787
DATA_DIR=.data
TRUST_PROXY=

# Required for npm start. At least 16 characters.
# Dev writes one in DATA_DIR when this is empty.
JWT_SECRET=

# Optional. Sign in with Google appears after this client id is set.
GOOGLE_CLIENT_ID=

# Optional. When host, user, and database are all set, church data is stored in MySQL.
# A partial MySQL setup does not fall back to SQLite.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Optional. NIV is read from API.Bible when this key is set. It stays on the server.
BIBLE_API_KEY=
