{
  "name": "scripture",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "data": "node scripts/prepare-data.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "start": "tsx server/index.ts --serve",
    "api": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "publish:iis": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-iis.ps1",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@fontsource/newsreader": "^5.2.8",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/noto-serif-hebrew": "^5.3.0",
    "@fontsource/source-sans-3": "^5.2.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "google-auth-library": "^10.4.0",
    "jsonwebtoken": "^9.0.2",
    "kokoro-js": "^1.2.1",
    "leaflet": "^1.9.4",
    "mysql2": "^3.15.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.8.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
